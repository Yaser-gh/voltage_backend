# ============================================================
# Environment configuration — copy to `.env` and fill in real values.
# NEVER commit the actual `.env` file to version control.
# ============================================================

# --- App ---
APP_NAME="Electrical Projects Management API"
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# --- Security / JWT ---
# Generate strong random secrets, e.g.: openssl rand -hex 64
SECRET_KEY=change-me-to-a-random-64-byte-hex-string
REFRESH_SECRET_KEY=change-me-to-a-different-random-64-byte-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_EXPIRE_DAYS_REMEMBER_ME=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# --- Database ---
DATABASE_URL=postgresql+asyncpg://voltage_user:voltage_pass@localhost:5432/voltage_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=300

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=true

# --- Rate limiting ---
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=3/minute

# --- Uploads ---
UPLOAD_DIR=app/uploads
MAX_UPLOAD_SIZE_MB=25
AVATAR_MAX_SIZE_MB=5

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=true
